# The website's build and dev server settings, as environment variables. `scripts/dev.sh`
# copies this to `.env` (gitignored) the first time the stack comes up, and the dev
# container reads it. On the host, export them yourself; the build reads nothing else.

# Where the built site will live; used for canonical links and the sitemap.
WEBSITE_URL=http://localhost:3005
# The license portal the premium plugins' trial and buy links open.
LICENSE_PORTAL_URL=https://licenses.manablox.io
# The license server's API; the build reads the prices from its catalogue. Empty shows
# "Paid plugin" without a price.
LICENSE_API=
# The CMS changelog the changelog page shows, fetched when the build or dev server starts.
# Empty, it is the CMS repository's CHANGELOG.md on main; `off`, or when the fetch fails,
# the copy in src/content/cms-changelog.md is used.
CHANGELOG_URL=
# 1 fails the build when that fetch fails or answers something else, instead of using the
# bundled copy. Release builds set it.
CHANGELOG_STRICT=
# The analytics server (Plausible) the site loads its script from. Empty is
# https://analytics.dev.alpenstudios.com.
ANALYTICS_ORIGIN=
